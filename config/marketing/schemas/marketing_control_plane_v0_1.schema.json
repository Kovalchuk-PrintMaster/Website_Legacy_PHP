{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forprint.net.ua/schemas/marketing/control-plane/v0.1",
  "title": "ForPrint Marketing Control Plane v0.1",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "status",
        "updated_at",
        "write_modes",
        "sources"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "marketing_source_registry"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "write_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "disabled",
              "preview_only",
              "operator_approved",
              "policy_managed"
            ]
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "adapter_family",
              "status",
              "credential_ref",
              "reporting_read",
              "configuration_write",
              "write_mode"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MKT-SRC-[A-Z0-9-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "adapter_family": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "status": {
                "enum": [
                  "planned",
                  "onboarding",
                  "active",
                  "paused",
                  "retired"
                ]
              },
              "credential_ref": {
                "type": "string",
                "pattern": "^FP_MARKETING_[A-Z0-9_]+$"
              },
              "reporting_read": {
                "enum": [
                  true,
                  false,
                  "future"
                ]
              },
              "configuration_write": {
                "enum": [
                  true,
                  false,
                  "future"
                ]
              },
              "write_mode": {
                "enum": [
                  "disabled",
                  "preview_only",
                  "operator_approved",
                  "policy_managed"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "status",
        "updated_at",
        "statuses",
        "programs"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "marketing_program_registry"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "statuses": {
          "type": "array",
          "uniqueItems": true
        },
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MKT-PROG-[A-Z0-9-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "proposed",
                  "planned",
                  "active",
                  "paused",
                  "completed",
                  "archived"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "status",
        "updated_at",
        "statuses",
        "management_modes",
        "campaigns"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "marketing_campaign_registry"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "statuses": {
          "type": "array",
          "uniqueItems": true
        },
        "management_modes": {
          "type": "array",
          "uniqueItems": true
        },
        "campaigns": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "status",
        "updated_at",
        "statuses",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "marketing_work_registry"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "statuses": {
          "type": "array",
          "uniqueItems": true
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "program_id",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^MKT-WORK-[A-Z0-9-]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "program_id": {
                "type": "string",
                "pattern": "^MKT-PROG-[A-Z0-9-]+$"
              },
              "status": {
                "enum": [
                  "backlog",
                  "ready",
                  "in_progress",
                  "blocked",
                  "paused",
                  "done",
                  "cancelled"
                ]
              },
              "priority": {
                "enum": [
                  "critical",
                  "high",
                  "normal",
                  "low"
                ]
              },
              "next_review_at": {
                "type": "string",
                "format": "date"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "status",
        "updated_at",
        "reports",
        "required_provenance"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "marketing_report_registry"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "reports": {
          "type": "array"
        },
        "required_provenance": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "status",
        "updated_at",
        "landing_pages",
        "required_fields"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "marketing_landing_page_registry"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "landing_pages": {
          "type": "array"
        },
        "required_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "status",
        "updated_at",
        "principles",
        "events"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1"
        },
        "kind": {
          "const": "marketing_measurement_event_contract"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "principles": {
          "type": "object"
        },
        "events": {
          "type": "array"
        }
      },
      "additionalProperties": false
    }
  ]
}
