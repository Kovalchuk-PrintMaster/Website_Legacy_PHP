# Local website preview environment.
# Copy to .env.website.local and fill real secrets there.
# Never commit .env.website.local.

FP_WEB_ENABLE_PHP_MAIL=1
FP_WEB_ENABLE_SMTP=0

# Telegram Bot API delivery.
# Required for delivery_status=sent_telegram.
FP_WEB_TELEGRAM_BOT_TOKEN=
FP_WEB_TELEGRAM_CHAT_ID=

# Optional direct SMTP fallback, currently disabled because local Exim/mail() works.
FP_WEB_SMTP_TIMEOUT=6
FP_WEB_SMTP_HOST=forprint.net.ua
FP_WEB_SMTP_PORT=587
FP_WEB_SMTP_ENCRYPTION=starttls
FP_WEB_SMTP_USER=office@forprint.net.ua
FP_WEB_SMTP_FROM=office@forprint.net.ua
FP_WEB_SMTP_FROM_NAME='ForPrint Website'
FP_WEB_SMTP_TO=office@forprint.net.ua
FP_WEB_SMTP_PASS=
